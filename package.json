{
  "name": "dsh-connect-teleagent",
  "version": "0.11.5",
  "description": "把本机登录的 TeleAgent（天翼 AI 星辰超级智能体桌面端）模型接入 DeepSeek Harness：原生内核流量 + 真流式 + 多轮 + 图片 + 工具调用 + 思维链 + 积分。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "teleagent",
    "model-provider",
    "credits",
    "vision"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": ">=0.85.0 <2.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "bin": {
    "dsh-connect-teleagent": "./lib/bin.js"
  },
  "scripts": {
    "test": "node --test test/unit.test.js test/credential.test.js test/store.test.js test/lifecycle.test.js test/health.test.js test/guard.test.js test/account.test.js test/welfare.test.js test/metadata.test.js test/accounts.test.js test/kernel.test.js test/loader.test.js test/attachments.test.js test/image-budget.test.js",
    "doctor": "node lib/doctor.js",
    "test:routes": "node test-routes.mjs",
    "test:e2e": "node test-e2e.mjs",
    "test:shim": "node test-shim-shape.mjs",
    "test:status": "node test-status-route.mjs",
    "verify": "npm test && node test-cli.mjs && node test-status-route.mjs && node test-shim-shape.mjs && node test-routes.mjs && node test-ui-render.mjs",
    "test:ui": "node test-ui-render.mjs",
    "preview": "node scripts/preview-card.mjs",
    "test:mcp": "node test-kernel-mcp.mjs"
  },
  "displayName": "TeleAgent 模型",
  "author": "anbulang",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/anbulang/dsh-connect-teleagent"
  },
  "homepage": "https://github.com/anbulang/dsh-connect-teleagent",
  "bugs": {
    "url": "https://github.com/anbulang/dsh-connect-teleagent/issues"
  }
}
